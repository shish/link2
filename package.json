{
    "name": "link",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "start": "vite --host 127.0.0.1",
        "build": "vite build",
        "test": "vitest",
        "preview": "vite preview",
        "format": "biome format --write .",
        "lint": "biome lint .",
        "check": "biome check .",
        "codegen": "graphql-codegen --watch",
        "cypress": "npx cypress open",
        "cypress-coverage": "rm -rf coverage .nyc_output ; npx cypress run ; npx nyc report --check-coverage --lines 80",
        "backend": "venv/bin/flask --app backend.app run --port 8000 --debug",
        "dev": "concurrently npm:start npm:test npm:codegen",
        "all": "concurrently npm:backend npm:start npm:test npm:codegen"
    },
    "dependencies": {
        "@apollo/client": "^4.2.12",
        "@fortawesome/free-solid-svg-icons": "^7.3.0",
        "@shish2k/react-faicon": "^0.1.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-router-dom": "^7.18.3",
        "react-tooltip": "^6.0.8",
        "usehooks-ts": "^3.1.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.11",
        "@graphql-codegen/cli": "^7.3.1",
        "@graphql-codegen/client-preset": "^6.0.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^6.1.1",
        "concurrently": "^10.0.5",
        "cypress": "^15.21.1",
        "sass": "^1.103.1",
        "typescript": "^7.0",
        "vite": "^8.2",
        "vitest": "^4.1.11"
    }
}
